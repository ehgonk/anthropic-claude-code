# Exemplo de arquivo .env para o Backend

# Configurações do Broker
BROKER_CORS_ORIGINS=http://localhost:5174,https://seu-frontend.onrender.com

# Porta do servidor (padrão: 8001)
PORT=8001

# URL do banco de dados (opcional - padrão: SQLite local)
# BROKER_DATABASE_URL=sqlite+aiosqlite:///data/broker.db

# Diretório de dados (opcional)
# BROKER_DATA_DIR=/app/data
